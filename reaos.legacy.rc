# convert legacy props

# overlay data
on early-init && property:ro.kernel.reaos.overlay=1
    trigger use_reaos_overlayfs


# display
on early-init && property:ro.kernel.reaos.width=*
    setprop ro.boot.reaos_width ${ro.kernel.reaos.width}

on early-init && property:ro.kernel.reaos.height=*
    setprop ro.boot.reaos_height ${ro.kernel.reaos.height}

on early-init && property:ro.kernel.reaos.fps=*
    setprop ro.boot.reaos_fps ${ro.kernel.reaos.fps}


# DNS
on early-init && property:ro.kernel.net.eth0.dns1=*
    setprop ro.boot.reaos_net_ndns 1
    setprop ro.boot.reaos_net_dns1 ${ro.kernel.net.eth0.dns1}


# network proxy
on early-init && property:ro.kernel.net.eth0.proxy.type=*
    setprop ro.boot.reaos_net_proxy_type ${ro.kernel.net.eth0.proxy.type}

on early-init && property:ro.kernel.net.eth0.proxy.host=*
    setprop ro.boot.reaos_net_proxy_host ${ro.kernel.net.eth0.proxy.host}

on early-init && property:ro.kernel.net.eth0.proxy.port=*
    setprop ro.boot.reaos_net_proxy_port ${ro.kernel.net.eth0.proxy.port}

on early-init && property:ro.kernel.net.eth0.proxy.exclusionList=*
    setprop ro.boot.reaos_net_proxy_exclude ${ro.kernel.net.eth0.proxy.exclusionList}

on early-init && property:ro.kernel.net.eth0.proxy.pac=*
    setprop ro.boot.reaos_net_proxy_pac ${ro.kernel.net.eth0.proxy.pac} 


# GPU
on early-init && property:ro.kernel.reaos.gpu.mode=*
    setprop ro.boot.reaos_gpu_mode ${ro.kernel.reaos.gpu.mode}

on early-init && property:ro.kernel.reaos.gpu.node=*
    setprop ro.boot.reaos_gpu_node ${ro.kernel.reaos.gpu.node}
